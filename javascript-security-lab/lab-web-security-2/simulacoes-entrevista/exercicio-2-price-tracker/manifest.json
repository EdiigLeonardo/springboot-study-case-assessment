{
  "manifest_version": 3,
  "name": "PriceWatch — alertas de preço",
  "version": "3.1.0",
  "description": "Segue preços nas lojas que visitas e avisa quando baixam.",
  "permissions": ["storage", "alarms", "notifications", "scripting", "tabs"],
  "optional_permissions": ["cookies", "history", "webNavigation"],
  "host_permissions": ["https://*.amazon.com/*", "https://*.worten.pt/*", "https://*.fnac.pt/*"],
  "optional_host_permissions": ["*://*/*"],
  "background": { "service_worker": "bg.js", "type": "module" },
  "action": { "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["https://*.amazon.com/*", "https://*.worten.pt/*", "https://*.fnac.pt/*"],
      "js": ["vendor.js", "cs.js"],
      "run_at": "document_idle"
    }
  ],
  "externally_connectable": {
    "matches": ["https://*.pricewatch.app/*", "https://*.partner-cdn.net/*"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' https://cdn.pricewatch.app; object-src 'self'"
  }
}
